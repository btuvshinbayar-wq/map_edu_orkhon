rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isConfirmed() {
      return signedIn() && me().isCompetitionConfirmed == true;
    }
    // Уралдааны ангилал: өөрийн анги/багш, эсвэл админ бүрдүүлсэн багт харьяалагддаг бол "team"
    function validCategory(g) {
      return g == me().grade || (g == 'team' && 'teamId' in me() && me().teamId != null);
    }

    // Админуудыг зөвхөн Console дээрээс гараар нэмнэ
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Хэрэглэгч
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Бүртгүүлэхдээ: өөрийн uid, сурагч/багшийн эрх, баталгаажаагүй төлөвтэй
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.status == 'pending'
        && request.resource.data.isCompetitionConfirmed == false
        && request.resource.data.mapAndChallengeAccess == true);

      // Өөрийн хувийн мэдээллийг л засна. Ангилал (grade), status, баталгаажуулалт, эрх, багийн талбарууд хаалттай:
      // уралдаан ангиллаар явагддаг тул ангиллыг зөвхөн админ өөрчилнө.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'phone', 'school', 'organization', 'aimag', 'soum', 'position', 'notes']));

      allow delete: if isAdmin();
    }

    // Давхаргын индекс ба геометр
    match /gisLayers/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /gisLayerData/{id}/chunks/{n} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Асуултын багцууд
    match /questionPacks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Оролдлого: зөвхөн баталгаажсан оролцогч өөрийн нэрээр үүсгэнэ. Засах/устгах нь админ
    match /attempts/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid
        && isConfirmed() && validCategory(request.resource.data.grade));
      allow update, delete: if isAdmin();
    }

    // Баг: админ зохион байгуулна
    match /teams/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Хандив: өөрийнхөө хандивыг л харна, админ бүгдийг
    match /donations/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /questionReports/{id} {
      allow create: if signedIn() && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Хувилбар, цагийн хуваарь, гэрчилгээний тохиргоо: хэн ч уншина, админ бичнэ
    match /app_settings/{id} { allow read: if true; allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
